{
  "name": "@dafitmatch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "ingest": "tsx src/jobs/ingest/cli.ts",
    "tag:products": "tsx src/jobs/tagging/cli.ts",
    "quiz:cards": "tsx src/jobs/quizcards/cli.ts",
    "catalog:report": "tsx src/jobs/report/cli.ts",
    "bench:feed": "tsx src/jobs/bench/feed.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.99",
    "@dafitmatch/shared": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@supabase/supabase-js": "2.117.2",
    "ai": "7.0.148",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
