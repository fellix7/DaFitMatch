# ─────────────────────────────────────────────────────────────
# DaFitMatch environment. Copy to `.env` at the repo root.
# NEVER commit real values. Placeholders only.
# Local values come from `pnpm supabase status` after `pnpm supabase start`.
# ─────────────────────────────────────────────────────────────

# ── Supabase (API side) ──────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key: used by the API to build user-scoped clients (RLS applies).
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Secret (service-role) key: API + jobs ONLY. Never in the browser, never VITE_-prefixed.
SUPABASE_SECRET_KEY=replace-with-secret-key
# Legacy HS256 JWT secret. Needed for local CLI stacks / projects not yet on asymmetric keys.
# Leave empty to verify only via the project's JWKS endpoint.
SUPABASE_JWT_SECRET=replace-with-local-jwt-secret
# Google sign-in for the LOCAL Supabase stack (read by supabase/config.toml).
# For a hosted project, set these in Dashboard -> Authentication -> Providers -> Google instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-oauth-client-secret
# Direct Postgres connection (pg-boss + /health). Local default port is 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── API server ───────────────────────────────────────────────
API_PORT=8787
# Exact origin of the web app; CORS allows only this.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── External services (API only; optional until their phase) ─
FAL_KEY=
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=
# LLM provider for the Vercel AI SDK (one is enough).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# ── Observability (placeholders this phase) ──────────────────
SENTRY_DSN=

# ── Web (Vite exposes only VITE_-prefixed vars to the browser) ─
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_API_URL=http://localhost:8787
# Dev/testing only: shows an email + password form for the shared developer account.
# NEVER set to true in production or Vercel preview deployments.
VITE_DEV_PASSWORD_LOGIN=false
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
